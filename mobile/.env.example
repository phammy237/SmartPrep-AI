# Copy this file to .env and fill in real values. .env is gitignored - never
# commit real keys.
#
# These two are the ONLY variables the mobile app itself needs. Anything
# prefixed EXPO_PUBLIC_ is bundled into the client and is not a secret - the
# anon key is safe to ship because every table it can touch is protected by
# Row Level Security (see supabase/migrations/).
#
# Find both values in your Supabase project: Settings > API.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# ---------------------------------------------------------------------------
# NOT used by the mobile app and NOT read from this file. Listed here so the
# full set of secrets this project will eventually need is visible in one
# place. These belong in Supabase Edge Function secrets (see README), never
# in a client .env, and don't exist yet - later phases (5 and beyond) add the
# Edge Functions that use them.
# ---------------------------------------------------------------------------
# OPENAI_API_KEY=
# USDA_API_KEY=
# THEMEALDB_API_KEY=
