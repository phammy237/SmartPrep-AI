# Copy this file to .env and fill in real values. .env is gitignored - never
# commit real keys.
#
# These are the variables the mobile app itself reads. Anything prefixed
# EXPO_PUBLIC_ is bundled into the client and is not a secret - the anon key
# is safe to ship because every table it can touch is protected by Row Level
# Security (see supabase/migrations/).
#
# Find both Supabase values in your Supabase project: Settings > API.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Ingredient-inference provider selection (see docs/INGREDIENT_MODEL_ROADMAP.md).
# Non-secret - just picks which backend Scan's photo inference uses.
#   blank/unset (the default) - no production ingredient-recognition provider
#     is configured. Photo capture is disabled with an honest "in development"
#     message; manual pantry entry and barcode scan are unaffected.
#   openai-benchmark - explicitly opts into the old OpenAI vision path, for
#     local development/testing only. Never set this in production.
# There is currently no value that activates SmartPrep's own future model -
# it has not been trained or deployed yet.
EXPO_PUBLIC_INGREDIENT_INFERENCE_PROVIDER=

# ---------------------------------------------------------------------------
# NOT used by the mobile app and NOT read from this file. These are Supabase
# Edge Function SECRETS - set them with `npx supabase secrets set NAME=...`,
# NEVER prefix them EXPO_PUBLIC_ and never put them in a client .env.
# ---------------------------------------------------------------------------
#
# USDA_API_KEY - FoodData Central API key. Consumed ONLY by the
#   supabase/functions/usda-lookup Edge Function (Phase 4). Get a free key at
#   https://fdc.nal.usda.gov/api-key-signup.html then:
#     npx supabase secrets set USDA_API_KEY=...
#   The Edge Function also relies on the platform-injected SUPABASE_URL,
#   SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY - you do not set those.
# USDA_API_KEY=
#
# OPENAI_API_KEY - OpenAI API key. Consumed ONLY by the
#   supabase/functions/scan-ingredients Edge Function - SmartPrep's optional
#   ingredient-scanning benchmark/fallback, not the production-primary path
#   (see docs/INGREDIENT_MODEL_ROADMAP.md). The Expo client NEVER sees it;
#   there is no EXPO_PUBLIC_OPENAI_*. Only relevant if you also set
#   EXPO_PUBLIC_INGREDIENT_INFERENCE_PROVIDER=openai-benchmark above.
#     npx supabase secrets set OPENAI_API_KEY=sk-...
#     npx supabase secrets set OPENAI_SCAN_MODEL=gpt-4o-mini   # optional, this is the default
#   Then deploy the function:
#     npx supabase functions deploy scan-ingredients
#   (Neither the secret nor the deploy has been done in this repo.)
# OPENAI_API_KEY=
#
# Not used yet (no function consumes them):
# THEMEALDB_API_KEY=
