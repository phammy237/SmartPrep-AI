# Copy this file to .env and fill in real values. .env is gitignored - never
# commit real keys.
#
# These two are the ONLY variables the mobile app itself needs. Anything
# prefixed EXPO_PUBLIC_ is bundled into the client and is not a secret - the
# anon key is safe to ship because every table it can touch is protected by
# Row Level Security (see supabase/migrations/).
#
# Find both values in your Supabase project: Settings > API.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# ---------------------------------------------------------------------------
# NOT used by the mobile app and NOT read from this file. These are Supabase
# Edge Function SECRETS - set them with `npx supabase secrets set NAME=...`,
# NEVER prefix them EXPO_PUBLIC_ and never put them in a client .env.
# ---------------------------------------------------------------------------
#
# USDA_API_KEY - FoodData Central API key. Consumed ONLY by the
#   supabase/functions/usda-lookup Edge Function (Phase 4). Get a free key at
#   https://fdc.nal.usda.gov/api-key-signup.html then:
#     npx supabase secrets set USDA_API_KEY=...
#   The Edge Function also relies on the platform-injected SUPABASE_URL,
#   SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY - you do not set those.
# USDA_API_KEY=
#
# Not used yet (no function consumes them):
# OPENAI_API_KEY=
# THEMEALDB_API_KEY=
